{
  "name": "apostando",
  "version": "0.1.0",
  "description": "Sistema de seguimiento y estadísticas para sorteos de Quini 6 y Loto Plus",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "init": "node init.js",
    "test": "jest --detectOpenHandles",
    "electron": "electron .",
    "electron-dev": "electron . --dev",
    "build": "electron-builder",
    "dist": "electron-builder --publish=never",
    "pack": "electron-builder --dir"
  },
  "keywords": [
    "quini6",
    "loto-plus",
    "sorteos",
    "estadisticas",
    "mysql"
  ],
  "author": "DaniPerego",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.12.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "mysql2": "^3.6.5"
  },
  "devDependencies": {
    "electron": "^38.4.0",
    "electron-builder": "^26.0.12",
    "electron-is-dev": "^3.0.1",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2"
  },
  "jest": {
    "testEnvironment": "jsdom"
  },
  "build": {
    "appId": "com.daniperego.apostando",
    "productName": "Apostando - Análisis de Sorteos",
    "directories": {
      "output": "output"
    },
    "files": [
      "main.js",
      "server.js",
      "init.js",
      "config/**/*",
      "routes/**/*",
      "public/**/*",
      "sql/**/*",
      "package.json",
      ".env",
      "node_modules/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Apostando"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png"
    }
  }
}
